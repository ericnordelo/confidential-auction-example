module Flows.Funding where

import Daml.Script
import DA.Assert ((===))
import Splice.Testing.Tokens.TestTokenV2 (Token)
import Auction.Assets
import Auction.Workflow
import Flows.Support

-- Only the seller can request round funding. A failure in proceeds creation
-- rolls back inventory locking, and a successful request consumes its preparation.
roundFundingGuards : Script ()
roundFundingGuards = do
  initial <- setup "round-funding-guards" False
  let e = basicSellerAccounts initial
      t = e.terms
  preparation <- submit (actAs t.ao <> readAs t.av) do
    exerciseCmd (grant e Preparation) StartRound with terms = t
  (small,smallDisclosure) <- mint e False t.inventory 99.0
  Some grantDisclosure <- queryDisclosure @Grant t.av (grant e Preparation)
  let disclosures = [grantDisclosure,smallDisclosure] <> e.staticDisclosures
      args = FundRound (grant e Preparation) [small] (cashContext e) (tokenContext e)
  submitMustFail (actAs t.ao <> readAs t.av <> discloseMany disclosures) do exerciseCmd preparation args
  submitMustFail (actAs e.sellerProvider <> discloseMany disclosures) do exerciseCmd preparation args
  submitMustFail (actAs t.seller <> discloseMany disclosures) do exerciseCmd preparation args
  assertActive t.av preparation
  assertActive t.tokenAdmin (fromInterfaceContractId @Token small)
  balance t.seller t.inventory t.tokenInstrument True >>= (=== 0.0)

  (rest,restDisclosure) <- mint e False t.inventory 1.0
  let completeArgs = args with inputs = [small,rest]
      completeDisclosures = restDisclosure :: disclosures
  -- Inventory would lock 100, but the second registry lacks its event-log context.
  submitMustFail (actAs t.seller <> discloseMany completeDisclosures) do
    exerciseCmd preparation (completeArgs with cashArgs = extra)
  assertActive t.av preparation
  assertActive t.tokenAdmin (fromInterfaceContractId @Token small)
  assertActive t.tokenAdmin (fromInterfaceContractId @Token rest)
  balance t.seller t.inventory t.tokenInstrument True >>= (=== 0.0)
  query @Proposal t.av >>= (\xs -> length xs === 0)
  query @RoundFundingRequest t.av >>= (\xs -> length xs === 0)
  -- An admission grant does not authorize preparation, even for the same parties.
  Some wrongGrant <- queryDisclosure @Grant t.av (grant e Admission)
  submitMustFail (actAs t.seller <> discloseMany (wrongGrant :: completeDisclosures)) do
    exerciseCmd preparation (completeArgs with preparation = grant e Admission)
  FundedRound proposal <- submitRoundFunding e preparation [small,rest]
  assertGone t.av preparation
  assertActive t.av proposal
  another <- submit (actAs t.ao <> readAs t.av) do
    exerciseCmd (grant e Preparation) StartRound with terms = t
  submitMustFail (actAs t.seller <> discloseMany completeDisclosures) do exerciseCmd another completeArgs
  -- Funding at the bidding cutoff is too late, even with fresh inventory.
  (fresh,freshDisclosure) <- mint e False t.inventory 100.0
  setTime t.biddingDeadline
  submitMustFail (actAs t.seller <> discloseMany (freshDisclosure :: disclosures)) do
    exerciseCmd another (args with inputs = [fresh])
  submit t.seller do exerciseCmd another AbandonRoundPreparation
  assertGone t.av another

-- Immediate allocation rejects insufficient funds. Failure in the second
-- registry also restores the first allocation, the bid and all input holdings.
fundingGuards : Script ()
fundingGuards = do
  e <- setup "funding" False
  let t = e.terms
      b = bidTerms e e.bob 5 12.0
  (round, published, _) <- openRound e
  (small, smallDisclosure) <- mint e True b.payment 599.0
  Some publishedDisclosure <- queryDisclosure @PublishedTerms t.av published
  Some preparationDisclosure <- queryDisclosure @Grant t.av (grant e Preparation)
  let disclosures = [publishedDisclosure,preparationDisclosure,smallDisclosure] <> e.staticDisclosures
      args = SubmitBid (grant e Preparation) b [small] (cashContext e) (tokenContext e)
  submitMustFail (actAs e.bob <> discloseMany disclosures) do exerciseCmd published args
  assertActive t.cashAdmin (fromInterfaceContractId @Token small)
  query @PreparedBid t.av >>= (\xs -> length xs === 0)
  balance e.bob b.payment t.cashInstrument True >>= (=== 0.0)
  balance e.bob b.payment t.cashInstrument False >>= (=== 599.0)

  (rest, restDisclosure) <- mint e True b.payment 1.0
  -- Cash would allocate 600, but the token factory lacks required context.
  submitMustFail (actAs e.bob <> discloseMany (restDisclosure :: disclosures)) do
    exerciseCmd published (args with inputs = [small,rest]; tokenArgs = extra)
  assertActive t.cashAdmin (fromInterfaceContractId @Token small)
  assertActive t.cashAdmin (fromInterfaceContractId @Token rest)
  query @PreparedBid t.av >>= (\xs -> length xs === 0)
  query @BidRequest t.av >>= (\xs -> length xs === 0)
  balance e.bob b.payment t.cashInstrument True >>= (=== 0.0)

  source@(FundedBid prepared) <- submitBid e published b [small,rest]
  assertSourceActive e source
  balance e.bob b.payment t.cashInstrument True >>= (=== 600.0)
  assertActive t.av round
  -- Reusing the consumed inputs cannot fund a second bid.
  submitMustFail (actAs e.bob <> discloseMany (restDisclosure :: disclosures)) do
    exerciseCmd published (args with inputs = [small,rest])
  assertActive t.av prepared
