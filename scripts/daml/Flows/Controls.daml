module Flows.Controls where

import Daml.Script
import DA.Assert ((===))
import DA.List (head)
import DA.Time (addRelTime, hours)
import Splice.Api.Token.AllocationV2 qualified as A
import Auction.Assets
import Splice.Testing.Tokens.TestTokenV2.Allocation
import Auction.Types
import Auction.Eligibility
import Auction.Workflow
import Flows.Support

-- Revocation leaves a current, provider-signed successor. Old evidence fails
-- validation. Current evidence gives the accepted bid zero fill.
credentialRevocation : Script ()
credentialRevocation = do
  e <- setup "credential" False
  (r0, published, supply) <- openRound e
  Some initialRound <- queryContractId e.terms.av r0
  let receipt = initialRound.proceedsReceipt.root
  bid <- prepareBid e published (bidTerms e e.alice 5 12.0)
  r1 <- acceptBatch e r0 supply [bid]
  status <- submit e.terms.eligibilityProvider do
    exerciseCmd bid.credential UpdateStatus with newExpiry = addRelTime e.start (hours 1); newRevoked = True
  closed <- closeRound e r1
  let currentBid = bid with credential = status
  input <- clearInput e closed supply [currentBid]
  let stale = input with bids = [(head input.bids) with credential = bid.credential]
  submitMustFail (actAs e.terms.ao <> readAs e.terms.av <> discloseMany e.disclosures) do
    exerciseCmd (grant e Clearing) ClearRound with round = closed; input = stale
  cleared <- clearRound e closed input
  Some result <- queryContractId e.terms.av cleared
  result.result === Result 8.0 [Fill 0 0 0.0 (Some "credential revoked")]

-- An externally cancelled allocation is missing funding, not an eligibility
-- exclusion. The complete clear fails and preserves every auction record.
cancelledPaymentBlocksClear : Script ()
cancelledPaymentBlocksClear = do
  e <- setup "cancelled" False
  (r0, published, supply) <- openRound e
  bid <- prepareBid e published (bidTerms e e.alice 5 12.0)
  r1 <- acceptBatch e r0 supply [bid]
  e <- withRegistryDisclosures e
  _ <- submit (actAs e.terms.av <> discloseMany e.disclosures) do
    exerciseCmd bid.currentLock A.Allocation_Cancel with actors = [e.terms.av]; extraArgs = cashContext e
  closed <- closeRound e r1
  input <- clearInput e closed supply [bid]
  submitMustFail (actAs e.terms.ao <> readAs e.terms.av <> discloseMany e.disclosures) do
    exerciseCmd (grant e Clearing) ClearRound with round = closed; input
  assertActive e.terms.av closed
  balance e.terms.issuer e.terms.proceeds e.terms.cashInstrument False >>= (=== 0.0)
  balance e.alice (bidTerms e e.alice 5 12.0).delivery e.terms.tokenInstrument False >>= (=== 0.0)

-- Missing Splice account context makes the second registry fail AFTER cash
-- settlement. Rollback restores both assets, all allocations and the approval.
atomicRollbackAndRetry : Script ()
atomicRollbackAndRetry = do
  e <- setup "rollback" True
  let t = e.terms
      bidTermsA = bidTerms e e.alice 5 12.0
  (r0, published, supply) <- openRound e
  Some initialRound <- queryContractId e.terms.av r0
  let receipt = initialRound.proceedsReceipt.root
  bid <- prepareBid e published bidTermsA
  r1 <- acceptBatch e r0 supply [bid]
  closed <- closeRound e r1
  input0 <- clearInput e closed supply [bid]
  Some r <- queryContractId t.av closed
  let settlement = settlementFor t r.roundId
      fill = head input0.proposed.fills
      payments = [paymentLeg t bidTermsA fill]
      deliveries = [deliveryLeg t bidTermsA fill]
  approval <- submit e.attester do
    createCmd $ BatchApproval e.attester settlement payments deliveries t.settlementDeadline
  e <- withRegistryDisclosures e
  let input = input0 with approval = Some approval; tokenArgs = extra
  submitMustFail (actAs t.ao <> readAs t.av <> discloseMany e.disclosures) do
    exerciseCmd (grant e Clearing) ClearRound with round = closed; input
  assertActive t.av closed
  assertActive t.av (head r.accepted)
  assertActive t.av (fromInterfaceContractId @TokenAllocationV2 bid.currentLock)
  assertActive t.av (fromInterfaceContractId @TokenAllocationV2 supply)
  assertActive t.av (fromInterfaceContractId @TokenAllocationV2 bid.currentReceipt)
  assertActive t.av (fromInterfaceContractId @TokenAllocationV2 receipt)
  assertActive t.av approval
  balance t.issuer t.proceeds t.cashInstrument False >>= (=== 0.0)
  balance e.alice bidTermsA.payment t.cashInstrument True >>= (=== 600.0)
  query @Outcome e.alice >>= (\xs -> length xs === 0)

  -- A retry supplies the actual upstream account policies and event log.
  _ <- clearRound e closed (input with tokenArgs = tokenContext e)
  balance t.issuer t.proceeds t.cashInstrument False >>= (=== 400.0)
  balance e.alice bidTermsA.delivery t.tokenInstrument False >>= (=== 50.0)
  assertGone t.av approval

-- Governance can pause admission while preserving close, expiry and recovery.
pauseAdmission : Script ()
pauseAdmission = do
  e <- setup "pause" False
  (round, published, supply) <- openRound e
  Some initialRound <- queryContractId e.terms.av round
  let receipt = initialRound.proceedsReceipt.root
  bid <- prepareBid e published (bidTerms e e.bob 5 12.0)
  submit e.terms.av do archiveCmd (grant e Admission)
  submitMustFail (actAs e.terms.ao <> readAs e.terms.av) do
    exerciseCmd (grant e Admission) AcceptBatch with round; supply; receipt; bids = [bid]
  _ <- closeRound e round
  ticket <- submit e.bob do exerciseCmd (preparedId bid) WithdrawPreparedBid
  _ <- releaseTicket e ticket bid.currentLock bid.currentReceipt
  pure ()
