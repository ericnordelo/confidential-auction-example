module Flows.Controls where

import Daml.Script
import DA.Assert ((===))
import DA.List (head)
import DA.Time (addRelTime, hours)
import DA.TextMap qualified as TM
import Splice.Api.Token.HoldingV2 qualified as H
import Splice.Api.Token.MetadataV1
import Splice.TokenStandard.Utils (toAnyContractId)
import OpenZeppelin.TokenCIP112V1.Allocation
import OpenZeppelin.TokenCIP112V1.Base
import OpenZeppelin.TokenCIP112V1.D1
import Auction.Types
import Auction.Eligibility
import Auction.Workflow
import Flows.Support

-- Revocation leaves a current, provider-signed successor. Old evidence fails
-- validation. Current evidence gives the accepted bid zero fill.
credentialRevocation : Script ()
credentialRevocation = do
  e <- setup "credential" False
  (r0, published, supply) <- openRound e
  bid <- prepareBid e published (bidTerms e e.alice 5 12.0)
  r1 <- acceptBatch e r0 supply [bid]
  status <- submit e.terms.eligibilityProvider do
    exerciseCmd bid.credential UpdateStatus with newExpiry = addRelTime e.start (hours 1); newRevoked = True
  closed <- closeRound e r1
  let currentBid = bid with credential = status
  input <- clearInput e closed supply [currentBid]
  let stale = input with bids = [(head input.bids) with credential = bid.credential]
  submitMustFail (actAs e.terms.ao <> readAs e.terms.av <> discloseMany e.disclosures) do
    exerciseCmd (grant e Clearing) ClearRound with round = closed; input = stale
  cleared <- clearRound e closed input
  Some result <- queryContractId e.terms.av cleared
  result.result === Result 8.0 [Fill 0 0 0.0 (Some "credential revoked")]

-- D2 consumes the original allocation. The auction authenticates its successor
-- by root, exact specification and still-live funding. A mark blocks recovery.
markedPayment : Script ()
markedPayment = do
  e <- setup "marked" False
  (r0, published, supply) <- openRound e
  bid <- prepareBid e published (bidTerms e e.alice 5 12.0)
  r1 <- acceptBatch e r0 supply [bid]
  marked <- submit e.terms.cashAdmin do
    exerciseCmd (fromInterfaceContractId @TokenAllocation bid.currentLock) TokenAllocation_MarkD2Seizure with
      seizureHook = D2SeizureHook "case-1" (H.Account (Some e.outsider) None "custodian") "held" (addRelTime e.start (hours 1))
  closed <- closeRound e r1
  input <- clearInput e closed supply [bid with currentLock = toInterfaceContractId marked]
  _ <- clearRound e closed input
  [(_, outcome)] <- query @Outcome e.alice
  outcome.fill.exclusion === Some "payment lock marked"
  Some ticket <- pure outcome.recovery
  submitMustFail (actAs e.terms.ao <> readAs e.terms.av) do
    exerciseCmd (grant e Recovery) Release with ticket; current = toInterfaceContractId marked
  unmarked <- submit e.terms.cashAdmin do exerciseCmd marked TokenAllocation_UnmarkD2Seizure
  _ <- submit (actAs e.terms.ao <> readAs e.terms.av) do exerciseCmd (grant e Recovery) Release with ticket; current = toInterfaceContractId unmarked
  balance e.alice (bidTerms e e.alice 5 12.0).payment e.terms.cashInstrument False >>= (=== 600.0)

-- The token registry requires real D1 approval. The first attempt deliberately
-- omits it, causing failure AFTER the cash registry call inside Round_Clear.
-- Ledger rollback must restore the cash, bids, locks and application approval.
atomicRollbackAndRetry : Script ()
atomicRollbackAndRetry = do
  e <- setup "rollback" True
  let t = e.terms
      bidTermsA = bidTerms e e.alice 5 12.0
  (r0, published, supply) <- openRound e
  bid <- prepareBid e published bidTermsA
  r1 <- acceptBatch e r0 supply [bid]
  closed <- closeRound e r1
  input0 <- clearInput e closed supply [bid]
  Some r <- queryContractId t.av closed
  let settlement = settlementFor t (toAnyContractId r.roundId)
      fill = head input0.proposed.fills
      payments = [paymentLeg t bidTermsA fill]
      deliveries = [deliveryLeg t bidTermsA fill]
  approval <- submit e.attester do
    createCmd $ BatchApproval e.attester settlement payments deliveries t.settlementDeadline
  let input = input0 with approval = Some approval
  submitMustFail (actAs t.ao <> readAs t.av <> discloseMany e.disclosures) do
    exerciseCmd (grant e Clearing) ClearRound with round = closed; input
  assertActive t.av closed
  assertActive t.av (head r.accepted)
  assertActive t.av (fromInterfaceContractId @TokenAllocation bid.currentLock)
  assertActive t.av (fromInterfaceContractId @TokenAllocation supply)
  assertActive t.av approval
  balance t.issuer t.proceeds t.cashInstrument False >>= (=== 0.0)
  balance e.alice bidTermsA.payment t.cashInstrument True >>= (=== 600.0)
  query @Outcome e.alice >>= (\xs -> length xs === 0)

  -- The attester then signs the exact token legs for the registry's D1 hook.
  -- The application approval above additionally binds SettlementInfo.cid/meta.
  now <- getTime
  attestation <- submit e.attester do
    createCmd ComplianceAttestation with
      attester = e.attester; attestationObservers = []
      settlementId = settlement.id; authorizedExecutors = [t.av]
      claimKind = "approved"; complianceReference = "approved-auction"
      issuedAt = now; expiresAt = t.settlementDeadline; boundTransferLegs = deliveries
  let args = ExtraArgs (ChoiceContext (TM.fromList [(d1AttestationContextKey, AV_ContractId (toAnyContractId attestation))])) emptyMetadata
  _ <- clearRound e closed (input with tokenArgs = args)
  balance t.issuer t.proceeds t.cashInstrument False >>= (=== 400.0)
  balance e.alice bidTermsA.delivery t.tokenInstrument False >>= (=== 50.0)
  assertGone t.av approval
  assertGone t.av attestation

-- Governance can pause admission while preserving close, expiry and recovery.
pauseAdmission : Script ()
pauseAdmission = do
  e <- setup "pause" False
  (round, published, supply) <- openRound e
  bid <- prepareBid e published (bidTerms e e.alice 5 12.0)
  submit e.terms.av do archiveCmd (grant e Admission)
  submitMustFail (actAs e.terms.ao <> readAs e.terms.av) do
    exerciseCmd (grant e Admission) AcceptBatch with round; supply; bids = [bid]
  _ <- closeRound e round
  ticket <- submit e.alice do exerciseCmd bid.prepared WithdrawPreparedBid
  _ <- submit (actAs e.terms.ao <> readAs e.terms.av) do exerciseCmd (grant e Recovery) Release with ticket; current = bid.currentLock
  pure ()
