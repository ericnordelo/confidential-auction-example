-- Shared setup and small actions. Each public flow below uses these helpers
-- to keep its transaction order visible without repeating registry plumbing.
module Flows.Support where

import Daml.Script
import DA.Action (foldlA)
import DA.TextMap qualified as TM
import DA.Time (addRelTime, hours, minutes, milliseconds)
import Splice.Api.Token.HoldingV2 qualified as H
import Splice.Api.Token.AllocationInstructionV2 qualified as F
import Splice.Api.Token.MetadataV1 (ExtraArgs)
import Splice.TokenStandard.Utils (accountParties)
import Splice.Testing.Tokens.TestTokenV2
import Auction.Types
import Auction.Assets
import Auction.Eligibility
import Auction.Workflow
import Flows.Fixtures

data Env = Env with
    terms : Terms
    issuerProvider : Party
    alice : Party
    aliceProvider : Party
    bob : Party
    carol : Party
    outsider : Party
    attester : Party
    grants : [(GrantKind, ContractId Grant)]
    disclosures : [Disclosure]
    staticDisclosures : [Disclosure]
    start : Time
    cashConfigs : [ContractId AccountConfig]
    tokenConfigs : [ContractId AccountConfig]

grant : Env -> GrantKind -> ContractId Grant
grant e kind = case lookup kind e.grants of
  Some cid -> cid
  None -> error "missing grant"

-- Every flow allocates fresh identities and bases deadlines on ledger time,
-- so it also runs against a persistent local Canton ledger with static time.
setup : Text -> Bool -> Script Env
setup = setupWith allocateParty

-- Network demonstrations supply an allocator that routes each role to its host.
setupWith : (Text -> Script Party) -> Text -> Bool -> Script Env
setupWith allocate prefix requireApproval = do
  issuer <- allocate (prefix <> "-issuer")
  issuerProvider <- allocate (prefix <> "-issuer-provider")
  av <- allocate (prefix <> "-validation")
  ao <- allocate (prefix <> "-operator")
  eligibilityProvider <- allocate (prefix <> "-eligibility")
  cashAdmin <- allocate (prefix <> "-cash-admin")
  tokenAdmin <- allocate (prefix <> "-token-admin")
  alice <- allocate (prefix <> "-alice")
  aliceProvider <- allocate (prefix <> "-alice-provider")
  bob <- allocate (prefix <> "-bob")
  carol <- allocate (prefix <> "-carol")
  outsider <- allocate (prefix <> "-outsider")
  attester <- allocate (prefix <> "-attester")
  start <- getTime
  cashRules <- submit cashAdmin do createCmd $ TokenRules cashAdmin
  tokenRules <- submit tokenAdmin do createCmd $ TokenRules tokenAdmin
  Some cashDisclosure <- queryDisclosure @TokenRules cashAdmin cashRules
  Some tokenDisclosure <- queryDisclosure @TokenRules tokenAdmin tokenRules
  -- Account policies are agreed once. Allocation instructions can later collect
  -- the owner and provider approvals in separate registry transactions.
  let inventory = H.Account (Some issuer) (Some issuerProvider) "inventory"
      proceeds = H.Account (Some issuer) (Some issuerProvider) "proceeds"
      payment = H.Account (Some alice) (Some aliceProvider) "payment"
      delivery = H.Account (Some alice) (Some aliceProvider) "delivery"
  cashAccounts <- mapA (createAccountConfig cashAdmin) [proceeds, payment]
  tokenAccounts <- mapA (createAccountConfig tokenAdmin) [inventory, delivery]
  grants <- forA [Preparation, Opening, Admission, Closing, Clearing, Termination, Recovery] $ \kind -> do
    cid <- submit av do createCmd Grant with av; ao; kind
    pure (kind, cid)
  let terms = Terms with
        issuer; av; ao; eligibilityProvider; cashAdmin; tokenAdmin; cashRules; tokenRules
        settlementAttester = if requireApproval then Some attester else None
        cashInstrument = "USD"
        tokenInstrument = "ISSUE"
        inventory; proceeds
        supplyLots = 10
        lotSize = 10.0
        reserve = 8.0
        priceTick = 1.0
        paymentQuantum = 0.01
        biddingDeadline = addRelTime start (minutes 10)
        settlementDeadline = addRelTime start (minutes 20)
        maxBids = 16
        maxBatch = 8
  pure Env with
    terms; issuerProvider; alice; aliceProvider; bob; carol; outsider; attester; grants
    disclosures = cashDisclosure :: tokenDisclosure :: map snd (cashAccounts <> tokenAccounts)
    staticDisclosures = cashDisclosure :: tokenDisclosure :: map snd (cashAccounts <> tokenAccounts)
    start; cashConfigs = map fst cashAccounts; tokenConfigs = map fst tokenAccounts


createAccountConfig : Party -> H.Account -> Script (ContractId AccountConfig, Disclosure)
createAccountConfig admin account = do
  let config = AccountConfig admin account (PartyConfig True True) (PartyConfig True True)
  Some provider <- pure account.provider
  Some owner <- pure account.owner
  proposal <- submit provider do createCmd $ AccountProposal config
  result <- submit owner do exerciseCmd proposal AccountProposal_Accept
  Some disclosure <- queryDisclosure @AccountConfig admin result.accountConfig
  pure (result.accountConfig, disclosure)

cashContext : Env -> ExtraArgs
cashContext e = registryArgs e.terms.cashRules e.cashConfigs

tokenContext : Env -> ExtraArgs
tokenContext e = registryArgs e.terms.tokenRules e.tokenConfigs

bidTerms : Env -> Party -> Int -> Decimal -> BidTerms
bidTerms e owner lots maxPrice =
  let provider = if owner == e.alice then Some e.aliceProvider else None
  in BidTerms owner (H.Account (Some owner) provider "payment") (H.Account (Some owner) provider "delivery") lots maxPrice

-- Fixture funding collects account consent separately, including across hosts.
-- The operator never submits with a bidder's or token admin's actAs authority.
mint : Env -> Bool -> H.Account -> Decimal -> Script (ContractId H.Holding, Disclosure)
mint e cash account amount = do
  let t = e.terms
      admin = if cash then t.cashAdmin else t.tokenAdmin
      rules = if cash then t.cashRules else t.tokenRules
  request <- submit admin do
    createCmd MintConsent with
      admin; account; amount; rules; approved = []
      instrument = if cash then t.cashInstrument else t.tokenInstrument
  consent <- foldlA (\cid approver -> do
    awaitVisible approver cid
    submit approver do exerciseCmd cid ApproveMint with approver) request (accountParties admin account)
  awaitVisible admin consent
  cid <- submit (actAs admin <> discloseMany e.disclosures) do exerciseCmd consent MintFixture with args = if cash then cashContext e else tokenContext e
  Some disclosure <- queryDisclosure @Token admin cid
  pure (toInterfaceContractId cid, disclosure)

-- Basic issuer accounts finish both requests with the owner's authority alone.
basicIssuerAccounts : Env -> Env
basicIssuerAccounts e = e with
  terms = e.terms with
    inventory = e.terms.inventory with provider = None
    proceeds = e.terms.proceeds with provider = None

-- The issuer submits alone. A live grant and registry context provide visibility.
submitRoundFunding : Env -> ContractId RoundPreparation -> [ContractId H.Holding] -> Script RoundSource
submitRoundFunding e preparation inputs = do
  awaitVisible e.terms.issuer preparation
  Some preparationDisclosure <- queryDisclosure @Grant e.terms.av (grant e Preparation)
  inputDisclosures <- forA inputs $ \cid -> do
    Some disclosure <- queryDisclosure @Token e.terms.tokenAdmin (fromInterfaceContractId cid)
    pure disclosure
  submit (actAs e.terms.issuer <> discloseMany (preparationDisclosure :: inputDisclosures <> e.staticDisclosures)) do
    exerciseCmd preparation FundRound with
      preparation = grant e Preparation; inputs; cashArgs = cashContext e; tokenArgs = tokenContext e

-- Providers act through their registries. The auction request stays unchanged.
completeRoundFunding : Env -> RoundSource -> Script (AllocationId, AllocationId)
completeRoundFunding e source = case source of
  FundedRound cid -> do
    Some p <- queryContractId e.terms.av cid
    pure (p.lock.root, p.receipt.root)
  RegistryPreparedRound cid -> do
    Some request <- queryContractId e.terms.av cid
    supply <- completeAllocation e False request.inventory
    receipt <- completeAllocation e True request.receipt
    pure (supply, receipt)

-- A signed funding request carries fixed terms while custody approval completes.
prepareRound : Env -> Script (RoundSource, AllocationId, AllocationId)
prepareRound e = do
  p0 <- submit (actAs e.terms.ao <> readAs e.terms.av) do exerciseCmd (grant e Preparation) StartRound with terms = e.terms
  (holding, _) <- mint e False e.terms.inventory (intToDecimal e.terms.supplyLots * e.terms.lotSize)
  source <- submitRoundFunding e p0 [holding]
  (supply, receipt) <- completeRoundFunding e source
  pure (source, supply, receipt)

openRound : Env -> Script (ContractId Round, ContractId PublishedTerms, AllocationId)
openRound e = do
  (source, supply, receipt) <- prepareRound e
  (round, published) <- submit (actAs e.terms.ao <> readAs e.terms.av) do exerciseCmd (grant e Opening) OpenRound with source; supply; receipt
  pure (round, published, supply)

-- One bidder submission signs the bid and requests both registry allocations.
-- Published terms and the live preparation grant are disclosed to the bidder.
submitBid : Env -> ContractId PublishedTerms -> BidTerms -> [ContractId H.Holding] -> Script BidSource
submitBid e published bid inputs = do
  Some publishedDisclosure <- queryDisclosure @PublishedTerms e.terms.av published
  Some preparationDisclosure <- queryDisclosure @Grant e.terms.av (grant e Preparation)
  inputDisclosures <- forA inputs $ \cid -> do
    Some disclosure <- queryDisclosure @Token e.terms.cashAdmin (fromInterfaceContractId cid)
    pure disclosure
  submit (actAs bid.bidder <> discloseMany ([publishedDisclosure,preparationDisclosure] <> inputDisclosures <> e.staticDisclosures)) do
    exerciseCmd published SubmitBid with
      preparation = grant e Preparation; bid; inputs; cashArgs = cashContext e; tokenArgs = tokenContext e

-- Pending approvals use only registry choices. The application request remains
-- unchanged, and a fresh holding disclosure is supplied at provider completion.
completeAllocation : Env -> Bool -> F.AllocationInstructionResult_Output -> Script AllocationId
completeAllocation e cash output = case output of
  F.AllocationInstructionResult_Completed cid -> pure cid
  F.AllocationInstructionResult_Pending cid -> do
    let admin = if cash then e.terms.cashAdmin else e.terms.tokenAdmin
    Some instruction <- queryContractId admin (fromInterfaceContractId @TokenAllocationInstructionV2 cid)
    Some provider <- pure instruction.allocation.authorizer.provider
    inputDisclosures <- forA (concatMap snd (TM.toList instruction.inputHoldingCids)) $ \holding -> do
      Some disclosure <- queryDisclosure @Token admin (fromInterfaceContractId holding)
      pure disclosure
    awaitVisible provider (fromInterfaceContractId @TokenAllocationInstructionV2 cid)
    result <- submit (actAs provider <> discloseMany (inputDisclosures <> e.staticDisclosures)) do
      exerciseCmd cid F.AllocationInstruction_Accept with
        actors = [provider]; extraArgs = if cash then cashContext e else tokenContext e
    case result.output of
      F.AllocationInstructionResult_Completed allocation -> pure allocation
      _ -> abort "provider approval did not complete the allocation"
  F.AllocationInstructionResult_Failed -> abort "allocation request failed"

completeBid : Env -> BidSource -> Script (AllocationId, AllocationId)
completeBid e source = case source of
  FundedBid cid -> do
    Some b <- queryContractId e.terms.av cid
    pure (b.lock.root, b.receipt.root)
  RegistryPreparedBid cid -> do
    Some b <- queryContractId e.terms.av cid
    payment <- completeAllocation e True b.payment
    receipt <- completeAllocation e False b.receipt
    pure (payment, receipt)

-- Each bid has distinct inputs and application state. Custodian approvals
-- complete through the registry before the operator can accept the bid.
prepareBid : Env -> ContractId PublishedTerms -> BidTerms -> Script AdmissionInput
prepareBid e published bid = do
  (holding, _) <- mint e True bid.payment (paymentFor e.terms bid.lots bid.maxPrice)
  prepared <- submitBid e published bid [holding]
  (currentLock, currentReceipt) <- completeBid e prepared
  credential <- issueCredential e bid.bidder
  pure AdmissionInput with prepared; currentLock; currentReceipt; credential

issueCredential : Env -> Party -> Script (ContractId Credential)
issueCredential e bidder =
  submit e.terms.eligibilityProvider do
    createCmd $ Credential e.terms.eligibilityProvider bidder e.terms.av None (addRelTime e.start (hours 1)) False

acceptBatch : Env -> ContractId Round -> AllocationId -> [AdmissionInput] -> Script (ContractId Round)
acceptBatch e round supply bids = do
  Some r <- queryContractId e.terms.av round
  submit (actAs e.terms.ao <> readAs e.terms.av) do
    exerciseCmd (grant e Admission) AcceptBatch with round; supply; receipt = r.proceedsReceipt.root; bids

closeRound : Env -> ContractId Round -> Script (ContractId Round)
closeRound e round = do
  setTime e.terms.biddingDeadline
  submit (actAs e.terms.ao <> readAs e.terms.av) do exerciseCmd (grant e Closing) CloseRound with round

-- This helper models operator computation. Round_Clear recomputes the result
-- itself and rejects a changed proposal. Updated evidence can be supplied later.
clearInput : Env -> ContractId Round -> AllocationId -> [AdmissionInput] -> Script ClearInput
clearInput e round supply inputs = do
  Some r <- queryContractId e.terms.av round
  bids <- forA (zip r.accepted inputs) $ \(accepted, i) -> do
    Some b <- queryContractId e.terms.av accepted
    Some c <- queryContractId e.terms.av i.credential
    now <- getTime
    let exclusion = if c.revoked then Some "credential revoked"
                    else if now >= c.validUntil then Some "credential expired" else None
    pure (ClearEvidence accepted i.currentLock i.currentReceipt i.credential, Quote b.number b.bid.lots b.bid.maxPrice exclusion)
  pure ClearInput with
    bids = map fst bids; supply; proceeds = r.proceedsReceipt.root
    proposed = computeResult e.terms (map snd bids)
    approval = None; cashArgs = cashContext e; tokenArgs = tokenContext e

clearRound : Env -> ContractId Round -> ClearInput -> Script (ContractId ClearedRound)
clearRound e round input = do
  e <- withRegistryDisclosures e
  submit (actAs e.terms.ao <> readAs e.terms.av <> discloseMany e.disclosures) do
    exerciseCmd (grant e Clearing) ClearRound with round; input

-- Query the account's total, separating freely usable and locked holdings.
balance : Party -> H.Account -> Text -> Bool -> Script Decimal
balance owner account instrument locked = do
  holdings <- query @Token owner
  pure (sum [h.holding.amount | (_, h) <- holdings, h.holding.account == account,
             h.holding.instrumentId.id == instrument, (h.holding.lock /= None) == locked])

assertActive : (Template t, HasEnsure t) => Party -> ContractId t -> Script ()
assertActive party cid = do
  Some _ <- queryContractId party cid
  pure ()

assertGone : (Template t, HasEnsure t) => Party -> ContractId t -> Script ()
assertGone party cid = do
  result <- queryContractId party cid
  case result of None -> pure (); Some _ -> abort "contract should have been consumed"

-- A submitter's completion does not mean every remote observer has indexed
-- the contract. Await its local visibility before the next party acts on it.
awaitValue : Text -> Script (Optional a) -> Script a
awaitValue = awaitValueLoop 300

awaitValueLoop : Int -> Text -> Script (Optional a) -> Script a
awaitValueLoop 0 label _ = abort ("visibility timeout: " <> label)
awaitValueLoop attempts label queryAction = do
  result <- queryAction
  case result of
    Some value -> pure value
    None -> do
      sleep (milliseconds 100)
      awaitValueLoop (attempts - 1) label queryAction

awaitVisible : (Template t, HasEnsure t) => Party -> ContractId t -> Script ()
awaitVisible party cid = do
  _ <- awaitValue (show cid) (queryContractId party cid)
  pure ()

-- Simulate the registry context endpoint: the admin supplies disclosed locked
-- holdings. This adds visibility to the command, never admin submission authority.
withRegistryDisclosures : Env -> Script Env
withRegistryDisclosures e = do
  allocations <- query @TokenAllocationV2 e.terms.av
  disclosures <- forA allocations $ \(_, a) ->
    forA (concatMap snd (TM.toList a.lockedTokens)) $ \cid -> do
      Some d <- queryDisclosure @Token a.allocation.admin (fromInterfaceContractId cid)
      pure d
  pure (e with disclosures = concat disclosures <> e.staticDisclosures)

releaseTicket : Env -> ContractId RecoveryTicket -> AllocationId -> AllocationId -> Script [ContractId H.Holding]
releaseTicket e ticket current receipt = do
  e <- withRegistryDisclosures e
  Some t <- queryContractId e.terms.av ticket
  let cashFunding = t.lock.specification.admin == e.terms.cashAdmin
  submit (actAs e.terms.ao <> readAs e.terms.av <> discloseMany e.disclosures) do
    exerciseCmd (grant e Recovery) Release with
      ticket; current; receipt
      fundingArgs = if cashFunding then cashContext e else tokenContext e
      receiptArgs = if cashFunding then tokenContext e else cashContext e

assertSourceActive : Env -> BidSource -> Script ()
assertSourceActive e source = case source of
  FundedBid cid -> assertActive e.terms.av cid
  RegistryPreparedBid cid -> assertActive e.terms.av cid

-- Immediate allocations produce PreparedBid and support early abandonment.
preparedId : AdmissionInput -> ContractId PreparedBid
preparedId input = case input.prepared of
  FundedBid cid -> cid
  RegistryPreparedBid _ -> error "this input uses a registry-prepared bid"
