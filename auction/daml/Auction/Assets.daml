module Auction.Assets where

import DA.Optional (fromOptional)

import DA.Foldable (forA_)
import DA.Action (unless)
import DA.List (dedupSort, head)
import DA.TextMap qualified as TM
import Splice.Api.Token.HoldingV2 qualified as H
import Splice.Api.Token.AllocationV2 qualified as A
import Splice.Api.Token.AllocationInstructionV2 qualified as F
import Splice.Api.Token.MetadataV1
import Splice.TokenStandard.Utils
import OpenZeppelin.TokenCIP112V1.Allocation (TokenAllocation(..))
import OpenZeppelin.TokenCIP112V1.Registry (TokenRules(..))

type AllocationId = ContractId A.Allocation

data LockBinding = LockBinding with
    root : AllocationId
    settlement : A.SettlementInfo
    specification : A.AllocationSpecification
  deriving (Eq, Show)

extra : ExtraArgs
extra = ExtraArgs emptyChoiceContext emptyMetadata

mkSpec : Party -> H.Account -> Time -> [A.TransferLegSide] -> A.AllocationSpecification
mkSpec admin account deadline sides = A.AllocationSpecification admin account sides (Some deadline) None True emptyMetadata

allocate : ContractId TokenRules -> A.SettlementInfo -> A.AllocationSpecification -> [ContractId H.Holding] -> Update AllocationId
allocate rules settlement spec inputs = do
  -- PublicFetch is necessary here: disclosure lets the operator resolve the
  -- factory, but does not grant the admin authority needed by a plain fetch.
  r <- exercise (toInterfaceContractId @F.AllocationFactory rules) F.AllocationFactory_PublicFetch with
    actors = accountParties spec.admin spec.authorizer
  assertMsg "wrong registry admin" (r.admin == spec.admin)
  now <- getTime
  result <- exercise (toInterfaceContractId @F.AllocationFactory rules) F.AllocationFactory_Allocate with
    settlement
    allocation = spec
    requestedAt = now
    inputHoldingCids = inputs
    actors = accountParties spec.admin spec.authorizer
    extraArgs = extra
  case result.output of
    F.AllocationInstructionResult_Completed cid -> pure cid
    _ -> abort "auction requires synchronous allocation completion"

-- This sender-only self-return leg reserves funds without authorizing a sale.
-- The clear must cancel it and obtain new, exact sender AND receiver approvals.
createLock : ContractId TokenRules -> Party -> H.Account -> Text -> Decimal -> Party -> Time -> AnyContractId -> [ContractId H.Holding] -> Update LockBinding
createLock rules admin account instrument amount av deadline preparation inputs = do
  let settlement = A.SettlementInfo [av] "auction-preparation" (Some preparation) emptyMetadata
      leg = A.TransferLeg "reserve" account account amount instrument emptyMetadata
      spec = mkSpec admin account deadline [senderSide leg]
  root <- allocate rules settlement spec inputs
  pure (LockBinding root settlement spec)

-- A successor is accepted only from this registry template and the same root.
-- Registry code and its upgrade governance remain part of the trust boundary.
checkLock : LockBinding -> AllocationId -> Update TokenAllocation
checkLock expected current = do
  a <- fetch (fromInterfaceContractId @TokenAllocation current)
  assertMsg "wrong allocation lineage" (fromOptional current a.originalAllocationCid == expected.root)
  assertMsg "changed allocation settlement" (a.settlement == expected.settlement)
  assertMsg "changed allocation specification" (a.allocation == expected.specification)
  let sides = expected.specification.transferLegSides
  assertMsg "lock must have one sender side" (length sides == 1 && (head sides).side == A.SenderSide)
  holdings <- mapA fetch a.lockedHoldingCids
  forA_ holdings $ \h -> do
    assertMsg "wrong funded account" (h.holding.account == expected.specification.authorizer)
    assertMsg "wrong funded instrument" (h.holding.instrumentId == H.InstrumentId expected.specification.admin (head sides).instrumentId)
    case h.holding.lock of
      None -> abort "allocation funding is not locked"
      Some l -> do
        assertMsg "wrong lock holders" (dedupSort l.holders == dedupSort (expected.specification.admin :: expected.settlement.executors))
        assertMsg "funding lock expires too early" (l.expiresAt == Some a.lockExpiresAt && a.lockExpiresAt > a.expiresAt)
  assertMsg "wrong funded amount" (sum (map (\h -> h.holding.amount) holdings) == (head sides).amount)
  pure a

cancel : Party -> AllocationId -> Update [ContractId H.Holding]
cancel av cid = do
  result <- exercise cid A.Allocation_Cancel with actors = [av]; extraArgs = extra
  pure (concatMap snd (TM.toList result.authorizerHoldingCids))

settle : ContractId TokenRules -> Party -> A.SettlementInfo -> [A.TransferLeg] -> [AllocationId] -> ExtraArgs -> Update ()
settle rules av settlement legs allocations args = unless (null legs) do
  _ <- exercise (toInterfaceContractId @A.SettlementFactory rules) A.SettlementFactory_SettleBatch with
    settlement
    transferLegs = legs
    allocations = map nonIteratedAllocation allocations
    actors = [av]
    extraArgs = args
  pure ()
