module Auction.Workflow where

import DA.Optional (isNone, isSome)

import DA.Foldable (forA_)
import DA.List (dedupSort)
import DA.TextMap qualified as TM
import Splice.Api.Token.HoldingV2 qualified as H
import Splice.Api.Token.AllocationV2 qualified as A
import Splice.Api.Token.AllocationInstructionV2 qualified as F
import Splice.Api.Token.MetadataV1
import Splice.TokenStandard.Utils (toAnyContractId, senderSide, receiverSide)
import Auction.Types
import Auction.Assets
import Auction.Eligibility

data GrantKind = Preparation | Opening | Admission | Closing | Clearing | Termination | Recovery
  deriving (Eq, Show)

data Phase = Open | Closed
  deriving (Eq, Show)

-- One template, separate contract instances. Revoking Admission does not
-- revoke Clearing or Recovery. There is no arbitrary-choice forwarding API.
template Grant with
    av : Party
    ao : Party
    kind : GrantKind
  where
    signatory av
    observer ao

    nonconsuming choice StartRound : ContractId RoundPreparation
      with terms : Terms
      controller ao
      do
        checkGrant this Preparation terms
        assertMsg "invalid round terms" (validTerms terms)
        create $ RoundPreparation terms

    nonconsuming choice OpenRound : (ContractId Round, ContractId PublishedTerms)
      with source : RoundSource; supply : AllocationId; receipt : AllocationId
      controller ao
      do
        proposal <- case source of
          FundedRound cid -> do
            p <- fetch cid
            checkGrant this Opening p.terms
            pure cid
          RegistryPreparedRound cid -> do
            request <- fetch cid
            checkGrant this Opening request.terms
            exercise cid CompleteFunding with supply; receipt
        exercise proposal Proposal_Open with supply; receipt

    nonconsuming choice AcceptBatch : ContractId Round
      with round : ContractId Round; bids : [AdmissionInput]; supply : AllocationId; receipt : AllocationId
      controller ao
      do
        r <- fetch round
        checkGrant this Admission r.terms
        exercise round Round_AcceptBatch with bids; supply; receipt

    nonconsuming choice CloseRound : ContractId Round
      with round : ContractId Round
      controller ao
      do
        r <- fetch round
        checkGrant this Closing r.terms
        exercise round Round_Close

    nonconsuming choice ClearRound : ContractId ClearedRound
      with round : ContractId Round; input : ClearInput
      controller ao
      do
        r <- fetch round
        checkGrant this Clearing r.terms
        exercise round Round_Clear with input

    nonconsuming choice EndRound : ContractId EndedRound
      with round : ContractId Round; expired : Bool; reason : Text
      controller ao
      do
        r <- fetch round
        checkGrant this Termination r.terms
        exercise round Round_End with expired; reason

    nonconsuming choice Release : [ContractId H.Holding]
      with ticket : ContractId RecoveryTicket; current : AllocationId; receipt : AllocationId; fundingArgs : ExtraArgs; receiptArgs : ExtraArgs
      controller ao
      do
        t <- fetch ticket
        assertMsg "wrong recovery grant" (kind == Recovery && t.av == av && t.ao == ao)
        exercise ticket Recover with current; receipt; fundingArgs; receiptArgs

    nonconsuming choice CloseUnsettledBid : ContractId Outcome
      with ended : ContractId EndedRound; bid : ContractId AcceptedBid
      controller ao
      do
        r <- fetch ended
        checkGrant this Recovery r.terms
        exercise ended Ended_CloseBid with bid

    nonconsuming choice CloseUnsettledSupply : ContractId RecoveryTicket
      with ended : ContractId EndedRound
      controller ao
      do
        r <- fetch ended
        checkGrant this Recovery r.terms
        exercise ended Ended_CloseSupply

checkGrant : Grant -> GrantKind -> Terms -> Update ()
checkGrant g kind t = assertMsg "wrong grant" (g.kind == kind && g.av == t.av && g.ao == t.ao)

before : Time -> Update ()
before deadline = do
  now <- getTime
  assertMsg "deadline reached" (now < deadline)

-- The issuer approves the terms and requests funding in one submission.
-- Account providers approve only the registry's allocation instructions.
template RoundPreparation with
    terms : Terms
  where
    signatory terms.av
    observer terms.ao, issuerParties terms
    ensure validTerms terms

    choice FundRound : RoundSource
      with preparation : ContractId Grant; inputs : [ContractId H.Holding]; cashArgs : ExtraArgs; tokenArgs : ExtraArgs
      controller terms.issuer
      do
        g <- fetch preparation
        checkGrant g Preparation terms
        before terms.biddingDeadline
        -- A single identity is known before either asset is allocated.
        let roundId = toAnyContractId self
            settlement = settlementFor terms roundId
            inventorySpec = mkSpec terms.tokenAdmin terms.inventory terms.settlementDeadline
              (TM.fromList [(terms.tokenInstrument, intToDecimal terms.supplyLots * terms.lotSize)])
            receiptSpec = mkSpec terms.cashAdmin terms.proceeds terms.settlementDeadline TM.empty
        inventory <- requestAllocation terms.tokenRules settlement inventorySpec inputs [terms.issuer] tokenArgs
        receipt <- requestAllocation terms.cashRules settlement receiptSpec [] [terms.issuer] cashArgs
        assertMsg "allocation request failed" (inventory.output /= F.AllocationInstructionResult_Failed && receipt.output /= F.AllocationInstructionResult_Failed)
        case (inventory.output, receipt.output) of
          (F.AllocationInstructionResult_Completed supply, F.AllocationInstructionResult_Completed proceeds) ->
            FundedRound <$> createRoundProposal terms roundId
              (LockBinding supply settlement inventorySpec) (LockBinding proceeds settlement receiptSpec)
          _ -> RegistryPreparedRound <$> create (RoundFundingRequest terms roundId inventory.output receipt.output)

    choice AbandonRoundPreparation : ()
      controller terms.issuer
      do pure ()

data RoundSource
  = FundedRound (ContractId Proposal)
  | RegistryPreparedRound (ContractId RoundFundingRequest)
  deriving (Eq, Show)

template RoundFundingRequest with
    terms : Terms
    roundId : AnyContractId
    inventory : F.AllocationInstructionResult_Output
    receipt : F.AllocationInstructionResult_Output
  where
    signatory terms.issuer, terms.av
    observer terms.ao, issuerParties terms
    ensure validTerms terms && inventory /= F.AllocationInstructionResult_Failed && receipt /= F.AllocationInstructionResult_Failed

    -- Abandonment ends the auction request. Registry withdrawal releases its assets.
    choice AbandonRoundFunding : ()
      controller terms.issuer
      do pure ()

    -- The opening grant binds completed allocations and opens in one transaction.
    choice CompleteFunding : ContractId Proposal
      with supply : AllocationId; receipt : AllocationId
      controller terms.av
      do
        before terms.biddingDeadline
        let settlement = settlementFor terms roundId
        lock <- bindAllocation settlement
          (mkSpec terms.tokenAdmin terms.inventory terms.settlementDeadline
            (TM.fromList [(terms.tokenInstrument, intToDecimal terms.supplyLots * terms.lotSize)])) supply
        receiving <- bindAllocation settlement
          (mkSpec terms.cashAdmin terms.proceeds terms.settlementDeadline TM.empty) receipt
        -- Preserve any side that already completed in the issuer's submission.
        checkCompletedRoot inventory lock
        checkCompletedRoot this.receipt receiving
        createRoundProposal terms roundId lock receiving

checkCompletedRoot : F.AllocationInstructionResult_Output -> LockBinding -> Update ()
checkCompletedRoot output binding = case output of
  F.AllocationInstructionResult_Completed cid -> assertMsg "changed completed allocation" (binding.root == cid)
  F.AllocationInstructionResult_Pending _ -> pure ()
  F.AllocationInstructionResult_Failed -> abort "allocation request failed"

createRoundProposal : Terms -> AnyContractId -> LockBinding -> LockBinding -> Update (ContractId Proposal)
createRoundProposal terms roundId lock receipt = do
  sale <- create $ SaleAuthority terms None lock receipt
  create $ Proposal terms roundId sale lock receipt

template Proposal with
    terms : Terms
    roundId : AnyContractId
    sale : ContractId SaleAuthority
    lock : LockBinding
    receipt : LockBinding
  where
    signatory terms.issuer, terms.av
    observer terms.ao

    choice Proposal_Open : (ContractId Round, ContractId PublishedTerms)
      with supply : AllocationId; receipt : AllocationId
      controller terms.av
      do
        before terms.biddingDeadline
        a <- checkLock lock supply
        receiving <- checkLock this.receipt receipt
        bound <- exercise sale BindSale with roundId
        round <- create $ Round terms roundId bound lock this.receipt Open [] 0
        published <- create $ PublishedTerms terms roundId
        pure (round, published)

    choice AbandonProposal : ContractId RecoveryTicket
      controller terms.issuer
      do exercise sale AbandonSale

template PublishedTerms with
    terms : Terms
    roundId : AnyContractId
  where
    signatory terms.issuer, terms.av
    observer terms.ao

    -- The bidder signs its terms and requests both allocations in one transaction.
    -- Custodian authority is collected by the registry's own instructions.
    nonconsuming choice SubmitBid : BidSource
      with preparation : ContractId Grant; bid : BidTerms; inputs : [ContractId H.Holding]; cashArgs : ExtraArgs; tokenArgs : ExtraArgs
      controller bid.bidder
      do
        g <- fetch preparation
        checkGrant g Preparation terms
        assertMsg "invalid bid" (validBid terms bid)
        before terms.biddingDeadline
        let settlement = settlementFor terms roundId
            paymentSpec = mkSpec terms.cashAdmin bid.payment terms.settlementDeadline
              (TM.fromList [(terms.cashInstrument, paymentFor terms bid.lots bid.maxPrice)])
            receiptSpec = mkSpec terms.tokenAdmin bid.delivery terms.settlementDeadline TM.empty
        payment <- requestAllocation terms.cashRules settlement paymentSpec inputs [bid.bidder] cashArgs
        receipt <- requestAllocation terms.tokenRules settlement receiptSpec [] [bid.bidder] tokenArgs
        assertMsg "allocation request failed" (payment.output /= F.AllocationInstructionResult_Failed && receipt.output /= F.AllocationInstructionResult_Failed)
        case (payment.output, receipt.output) of
          (F.AllocationInstructionResult_Completed cash, F.AllocationInstructionResult_Completed token) -> do
            let lock = LockBinding cash settlement paymentSpec
                receiving = LockBinding token settlement receiptSpec
            FundedBid <$> create (PreparedBid terms roundId bid lock receiving)
          _ -> RegistryPreparedBid <$> create (BidRequest terms roundId bid payment.output receipt.output)

template BidRequest with
    terms : Terms
    roundId : AnyContractId
    bid : BidTerms
    payment : F.AllocationInstructionResult_Output
    receipt : F.AllocationInstructionResult_Output
  where
    signatory terms.av, bid.bidder
    observer terms.issuer, terms.ao, bidParties terms bid
    ensure validBid terms bid && payment /= F.AllocationInstructionResult_Failed && receipt /= F.AllocationInstructionResult_Failed

    choice AbandonBidRequest : ()
      controller bid.bidder
      do pure ()

    -- External registry workflows are bound only inside batch acceptance.
    -- Before admission the application creates no cancellation ticket for them.
    choice AcceptRegistryPrepared : ContractId AcceptedBid
      with payment : AllocationId; receipt : AllocationId; number : Int; credentialRoot : ContractId Credential
      controller terms.issuer, terms.av
      do
        before terms.biddingDeadline
        (lock, receiving) <- bindBidAllocations terms roundId bid payment receipt
        create $ AcceptedBid terms roundId bid lock receiving number credentialRoot

bindBidAllocations : Terms -> AnyContractId -> BidTerms -> AllocationId -> AllocationId -> Update (LockBinding, LockBinding)
bindBidAllocations terms roundId bid payment receipt = do
  let settlement = settlementFor terms roundId
  lock <- bindAllocation settlement
    (mkSpec terms.cashAdmin bid.payment terms.settlementDeadline
      (TM.fromList [(terms.cashInstrument, paymentFor terms bid.lots bid.maxPrice)])) payment
  receiving <- bindAllocation settlement
    (mkSpec terms.tokenAdmin bid.delivery terms.settlementDeadline TM.empty) receipt
  pure (lock, receiving)


template PreparedBid with
    terms : Terms
    roundId : AnyContractId
    bid : BidTerms
    lock : LockBinding
    receipt : LockBinding
  where
    signatory terms.av, bid.bidder
    observer terms.issuer, terms.ao, bidParties terms bid

    choice Prepared_Accept : ContractId AcceptedBid
      with number : Int; credentialRoot : ContractId Credential
      controller terms.issuer, terms.av
      do create $ AcceptedBid terms roundId bid lock receipt number credentialRoot

    choice WithdrawPreparedBid : ContractId RecoveryTicket
      controller bid.bidder
      do ticketFor terms (bidParties terms bid) lock receipt "unaccepted bid abandoned"

data BidSource
  = FundedBid (ContractId PreparedBid)
  | RegistryPreparedBid (ContractId BidRequest)
  deriving (Eq, Show)

data AdmissionInput = AdmissionInput with
    prepared : BidSource
    currentLock : AllocationId
    currentReceipt : AllocationId
    credential : ContractId Credential
  deriving (Eq, Show)

sourceIdentity : BidSource -> AnyContractId
sourceIdentity source = case source of
  FundedBid cid -> toAnyContractId cid
  RegistryPreparedBid cid -> toAnyContractId cid

-- Read authenticated terms and both completed allocation bindings. This
-- constructs a value for validation, not a new on-ledger PreparedBid.
admissionDetails : AdmissionInput -> Update PreparedBid
admissionDetails input = case input.prepared of
  FundedBid cid -> fetch cid
  RegistryPreparedBid cid -> do
    p <- fetch cid
    (lock, receipt) <- bindBidAllocations p.terms p.roundId p.bid input.currentLock input.currentReceipt
    pure (PreparedBid p.terms p.roundId p.bid lock receipt)

data ClearEvidence = ClearEvidence with
    accepted : ContractId AcceptedBid
    currentLock : AllocationId
    currentReceipt : AllocationId
    credential : ContractId Credential
  deriving (Eq, Show)

data ClearInput = ClearInput with
    bids : [ClearEvidence]
    supply : AllocationId
    proceeds : AllocationId
    proposed : Result
    approval : Optional (ContractId BatchApproval)
    cashArgs : ExtraArgs
    tokenArgs : ExtraArgs
  deriving (Eq, Show)

template Round with
    terms : Terms
    roundId : AnyContractId
    sale : ContractId SaleAuthority
    supplyLock : LockBinding
    proceedsReceipt : LockBinding
    phase : Phase
    accepted : [ContractId AcceptedBid]
    nextNumber : Int
  where
    signatory terms.issuer, terms.av
    observer terms.ao
    ensure nextNumber == length accepted && nextNumber <= terms.maxBids && length (dedupSort accepted) == length accepted

    choice Round_AcceptBatch : ContractId Round
      with bids : [AdmissionInput]; supply : AllocationId; receipt : AllocationId
      controller terms.av
      do
        assertMsg "round is closed" (phase == Open)
        before terms.biddingDeadline
        assertMsg "invalid batch size" (not (null bids) && length bids <= terms.maxBatch && nextNumber + length bids <= terms.maxBids)
        assertMsg "duplicate prepared bid" (length (dedupSort (map (sourceIdentity . (.prepared)) bids)) == length bids)
        existing <- mapA fetch accepted
        incoming <- mapA admissionDetails bids
        let roots = concatMap (\b -> [b.lock.root, b.receipt.root]) existing
              <> concatMap (\b -> [b.lock.root, b.receipt.root]) incoming
        assertMsg "allocation reused by multiple bids" (length (dedupSort roots) == length roots)
        a <- checkLock supplyLock supply
        receiving <- checkLock proceedsReceipt receipt
        new <- forA (zip [nextNumber..nextNumber + length bids - 1] (zip bids incoming)) $ \(number, (input, p)) -> do
          assertMsg "wrong bid round or terms" (p.roundId == roundId && p.terms == terms && validBid terms p.bid)
          allocation <- checkLock p.lock input.currentLock
          receiving <- checkLock p.receipt input.currentReceipt
          (root, exclusion) <- checkCredential terms.eligibilityProvider p.bid.bidder terms.av None input.credential
          assertMsg "bidder not eligible" (isNone exclusion)
          case input.prepared of
            FundedBid cid -> exercise cid Prepared_Accept with number; credentialRoot = root
            RegistryPreparedBid cid -> exercise cid AcceptRegistryPrepared with
              payment = input.currentLock; receipt = input.currentReceipt; number; credentialRoot = root
        create this with accepted = accepted <> new; nextNumber = nextNumber + length new

    choice Round_Close : ContractId Round
      controller terms.av
      do
        now <- getTime
        assertMsg "round cannot close yet" (phase == Open && now >= terms.biddingDeadline)
        create this with phase = Closed

    choice Round_Clear : ContractId ClearedRound
      with input : ClearInput
      controller terms.av
      do
        assertMsg "round must be closed" (phase == Closed)
        before terms.settlementDeadline
        assertMsg "accepted list changed" (map (.accepted) input.bids == accepted)
        supply <- checkLock supplyLock input.supply
        receiving <- checkLock proceedsReceipt input.proceeds
        verified <- forA (zip [0..length input.bids - 1] input.bids) $ \(number, e) -> do
          b <- fetch e.accepted
          assertMsg "accepted record mismatch" (b.terms == terms && b.roundId == roundId && b.number == number)
          allocation <- checkLock b.lock e.currentLock
          receiving <- checkLock b.receipt e.currentReceipt
          (_, excluded) <- checkCredential terms.eligibilityProvider b.bid.bidder terms.av (Some b.credentialRoot) e.credential
          let exclusion = excluded
          pure (b, Quote number b.bid.lots b.bid.maxPrice exclusion)
        let result = computeResult terms (map snd verified)
            settlement = settlementFor terms roundId
            winners = [(b.bid, f) | ((b, _), f) <- zip verified result.fills, f.lots > 0]
            payments = map (uncurry (paymentLeg terms)) winners
            deliveries = map (uncurry (deliveryLeg terms)) winners
        assertMsg "incorrect proposed clearing result" (input.proposed == result)
        -- Each child sees only its own result. The complete list remains here.
        finished <- forA (zip input.bids result.fills) $ \(e, fill) ->
          exercise e.accepted FinalizeBid with current = e.currentLock; receipt = e.currentReceipt; fill; price = result.price
        (issuerCash, issuerToken) <- exercise sale FinalizeSale with current = input.supply; receipt = input.proceeds; price = result.price; payments; deliveries
        -- The optional application approval binds the full round reference
        -- and exact legs before either registry settles.
        forA_ terms.settlementAttester $ \attester -> do
          approval <- case input.approval of
            None -> abort "missing exact auction approval"
            Some cid -> pure cid
          a <- fetch approval
          assertMsg "wrong settlement attester" (a.attester == attester)
          exercise approval VerifyBatch with expected = settlement; expectedPayments = payments; expectedDeliveries = deliveries
        -- Both registries execute inside this one parent transaction. A token
        -- factory failure rolls back even an already-executed cash factory.
        settle terms.cashRules terms.av settlement payments (concatMap (.cash) finished <> issuerCash) input.cashArgs
        settle terms.tokenRules terms.av settlement deliveries (concatMap (.token) finished <> issuerToken) input.tokenArgs
        create $ ClearedRound terms roundId result (map (.outcome) finished)

    choice Round_End : ContractId EndedRound
      with expired : Bool; reason : Text
      controller terms.av
      do
        now <- getTime
        assertMsg "reason required" (reason /= "")
        assertMsg "expiry claimed too early" (not expired || now >= terms.settlementDeadline)
        create $ EndedRound terms roundId sale accepted reason

data FinalizedBid = FinalizedBid with
    cash : [A.FinalizedAllocation]
    token : [A.FinalizedAllocation]
    outcome : ContractId Outcome
  deriving (Eq, Show)

template AcceptedBid with
    terms : Terms
    roundId : AnyContractId
    bid : BidTerms
    lock : LockBinding
    receipt : LockBinding
    number : Int
    credentialRoot : ContractId Credential
  where
    signatory terms.issuer, terms.av, bid.bidder
    observer terms.ao, bidParties terms bid

    choice FinalizeBid : FinalizedBid
      with current : AllocationId; receipt : AllocationId; fill : Fill; price : Decimal
      controller terms.av
      do
        before terms.settlementDeadline
        assertMsg "invalid local fill" (fill.number == number && fill.lots >= 0 && fill.lots <= bid.lots)
        assertMsg "invalid local price or payment" (price >= terms.reserve && (fill.lots == 0 || price <= bid.maxPrice)
          && fill.payment == paymentFor terms fill.lots price && fill.payment <= paymentFor terms bid.lots bid.maxPrice)
        _ <- checkLock lock current
        _ <- checkLock this.receipt receipt
        (cash, token) <- if fill.lots == 0
          -- Empty sides close both allocations and refund all reserved payment.
          then pure ([finalize current []], [finalize receipt []])
          else do
            assertMsg "excluded bid cannot win" (isNone fill.exclusion)
            -- Account consent is already carried by the two allocations.
            -- These values add exact sides; they create no new allocations.
            pure ([finalize current [senderSide (paymentLeg terms bid fill)]],
                  [finalize receipt [receiverSide (deliveryLeg terms bid fill)]])
        outcome <- create $ Outcome terms.av terms.issuer terms.ao (bidParties terms bid) roundId number fill None
        pure FinalizedBid with cash; token; outcome

    choice CloseBidWithoutSale : ContractId Outcome
      with reason : Text
      controller terms.av
      do
        ticket <- ticketFor terms (bidParties terms bid) lock receipt reason
        create $ Outcome terms.av terms.issuer terms.ao (bidParties terms bid) roundId number (Fill number 0 0.0 (Some reason)) (Some ticket)

template SaleAuthority with
    terms : Terms
    boundRound : Optional AnyContractId
    lock : LockBinding
    receipt : LockBinding
  where
    signatory terms.av, terms.issuer
    observer terms.ao, issuerParties terms

    choice BindSale : ContractId SaleAuthority
      with roundId : AnyContractId
      controller terms.av
      do
        assertMsg "sale already bound" (isNone boundRound)
        create this with boundRound = Some roundId

    choice AbandonSale : ContractId RecoveryTicket
      controller terms.av
      do
        assertMsg "sale is bound to a round" (isNone boundRound)
        ticketFor terms (issuerParties terms) lock receipt "proposal abandoned"

    choice FinalizeSale : ([A.FinalizedAllocation], [A.FinalizedAllocation])
      with current : AllocationId; receipt : AllocationId; price : Decimal; payments : [A.TransferLeg]; deliveries : [A.TransferLeg]
      controller terms.av
      do
        assertMsg "sale not bound" (isSome boundRound)
        before terms.settlementDeadline
        assertMsg "unpaired sale legs" (length payments == length deliveries)
        assertMsg "price below reserve" (price >= terms.reserve)
        assertMsg "too much inventory" (sum (map (.amount) deliveries) <= intToDecimal terms.supplyLots * terms.lotSize)
        forA_ (zip payments deliveries) $ \(p, d) -> do
          let lots = floor (d.amount / terms.lotSize)
          assertMsg "invalid delivery" (d.sender == terms.inventory && d.instrumentId == terms.tokenInstrument
            && lots > 0 && d.amount == intToDecimal lots * terms.lotSize)
          assertMsg "invalid proceeds" (p.receiver == terms.proceeds && p.instrumentId == terms.cashInstrument
            && p.sender.owner == d.receiver.owner && p.amount == paymentFor terms lots price)
        _ <- checkLock lock current
        _ <- checkLock this.receipt receipt
        -- With no winners, empty sides release all inventory through settlement.
        pure ([finalize receipt (map receiverSide payments)], [finalize current (map senderSide deliveries)])

    choice CloseSaleWithoutSale : ContractId RecoveryTicket
      with reason : Text
      controller terms.av
      do ticketFor terms (issuerParties terms) lock receipt reason

-- The account parties keep visibility of their own outcome, not the whole book.
template Outcome with
    av : Party
    issuer : Party
    ao : Party
    parties : [Party]
    roundId : AnyContractId
    number : Int
    fill : Fill
    recovery : Optional (ContractId RecoveryTicket)
  where
    signatory av
    observer issuer, ao, parties

template ClearedRound with
    terms : Terms
    roundId : AnyContractId
    result : Result
    outcomes : [ContractId Outcome]
  where
    signatory terms.issuer, terms.av
    observer terms.ao

template EndedRound with
    terms : Terms
    roundId : AnyContractId
    sale : ContractId SaleAuthority
    accepted : [ContractId AcceptedBid]
    reason : Text
  where
    signatory terms.issuer, terms.av
    observer terms.ao

    nonconsuming choice Ended_CloseBid : ContractId Outcome
      with bid : ContractId AcceptedBid
      controller terms.av
      do
        assertMsg "bid was not accepted" (bid `elem` accepted)
        exercise bid CloseBidWithoutSale with reason

    nonconsuming choice Ended_CloseSupply : ContractId RecoveryTicket
      controller terms.av
      do exercise sale CloseSaleWithoutSale with reason

ticketFor : Terms -> [Party] -> LockBinding -> LockBinding -> Text -> Update (ContractId RecoveryTicket)
ticketFor t parties lock receipt reason = create $ RecoveryTicket t.av t.ao parties lock receipt reason

template RecoveryTicket with
    av : Party
    ao : Party
    parties : [Party]
    lock : LockBinding
    receipt : LockBinding
    reason : Text
  where
    signatory av
    observer ao, parties

    choice Recover : [ContractId H.Holding]
      with current : AllocationId; receipt : AllocationId; fundingArgs : ExtraArgs; receiptArgs : ExtraArgs
      controller av
      do
        _ <- checkLock lock current
        _ <- checkLock this.receipt receipt
        returned <- cancel av current fundingArgs
        _ <- cancel av receipt receiptArgs
        pure returned

-- The application's optional approval binds the full settlement reference
-- and the two admins' leg sets.
template BatchApproval with
    attester : Party
    settlement : A.SettlementInfo
    payments : [A.TransferLeg]
    deliveries : [A.TransferLeg]
    expiresAt : Time
  where
    signatory attester
    observer settlement.executors

    choice VerifyBatch : ()
      with expected : A.SettlementInfo; expectedPayments : [A.TransferLeg]; expectedDeliveries : [A.TransferLeg]
      controller settlement.executors
      do
        before expiresAt
        assertMsg "approval reference or legs mismatch" (expected == settlement && expectedPayments == payments && expectedDeliveries == deliveries)
